{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chandni-whatsapp-agent",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": ["META_VERIFY_TOKEN", "META_APP_SECRET", "META_ACCESS_TOKEN", "KIMI_API_KEY", "AGENT_ADMIN_KEY"]
  },
  "vars": {
    "PHONE_NUMBER_ID": "1329088423615686",
    "WABA_ID": "2150197029173188",
    "CATALOG_ORIGIN": "https://chandni-catalog.pages.dev",
    "KIMI_MODEL": "kimi-k2.6"
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "chandni-catalog",
      "database_id": "c1978fb2-5f08-48f9-94b9-58d6bdfc1628"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
