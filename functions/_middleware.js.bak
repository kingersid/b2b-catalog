// Middleware: route /designs/* requests to R2 image proxy
// For non-matching routes, falls through to the next matching function
export async function onRequest({ request, env }) {
  const url = new URL(request.url);
  const path = url.pathname;

  // Route /designs/{size}/{filename} to R2 image proxy
  if (path.startsWith('/designs/')) {
    const parts = path.split('/');
    // ["", "designs", "original", "id.jpg"]
    if (parts.length >= 4) {
      const size = parts[2];
      const filename = parts.slice(3).join('/'); // handle dots in filename
      const validSizes = ['original', 'mid', 'webp'];
      
      if (validSizes.includes(size)) {
        const key = `designs/${size}/${filename}`;
        const object = await env.DESIGNS_BUCKET.get(key);
        
        if (!object) {
          return new Response('Not found', { status: 404 });
        }

        const headers = new Headers();
        object.writeHttpMetadata(headers);
        headers.set('cache-control', 'public, max-age=31536000, immutable');
        headers.set('access-control-allow-origin', '*');
        return new Response(object.body, { headers });
      }
    }
  }

  // All other routes fall through to the next matching function
  // (do NOT return anything here — Pages Functions routes to the appropriate handler)
}
